// SPDX-License-Identifier: Apache-2.0 AND MIT
// Portions ported from intel/llm-scaler omni_xpu_kernel kitchen_deferred.cpp (fd4a584, MIT), which follows
// Strata's verify kernels: Copyright (c) 2026 Niko1221 and the Strata contributors.
// MIT license text: licenses/Strata-MIT.txt. See THIRD_PARTY_NOTICES.md.
// Single-launch Qwen3.5 Gated-DeltaNet decode layer (verify rows S <= 8, batch 1), bit-identical to
//   x += out_proj(GDN(input_layernorm(x)));  x += mlp(post_attention_layernorm(x))
// with GDN = Kitchen's deferred conv / gates / sums / replay-verify delta (llm-scaler fd4a584
// kitchen_deferred.cpp) and in_proj_a/b in oneDNN's small-M BF16 order.
//
//   P1  rows    xn = RMSNorm(x); q1 = rot_quant(xn)
//   P2  all     proj | z = W4(q1) (stream engine);  last WG first: a, b = BF16 linear(xn)
//   P3  all     deferred conv (one channel per thread) | gates
//   P4  all     q/k sum of squares
//   P5  heads   replay + verify delta, gated RMSNorm -> core
//   P6  rows    q1 = rot_quant(core)
//   P7  all     x1 = x + out_proj(q1)
//   P8  rows    q1 = rot_quant(RMSNorm(x1))
//   P9  all     h = silu(gate) * up
//   P10 rows    q2 = rot_quant(h)
//   P11 all     x = x1 + down(q2)
// The Kitchen arithmetic is ported operation for operation, including what its fast-math build
// does (ISA-checked): sequential FMAs in the delta recurrences, (q * scale) * qi,
// (raw * w) * rsqrt, EU math.rsqt.
#include <cstdint>
#include <map>
#include <optional>
#include <type_traits>

#include <c10/xpu/XPUStream.h>
#include <torch/extension.h>

#include "mono_common.hpp"

namespace mono_decode_xpu {
namespace {
using namespace mono;
constexpr int SLOT = 8, DH = 128, RG = 4, RPG = DH / RG, CW = 3;  // CW: conv state width (kernel size - 1)
constexpr int NCTL = 2 + 3 * SLOT;  // ctl: pending, parity, accepted slots, tree parents, verify instructions
static_assert(SLOT == 8, "the conv output store packs 8 BF16 values");
constexpr int64_t PF_P1 = 192 << 10, PF_O = 320 << 10, PF_G = 320 << 10, PF_D = 192 << 10;

W4 w4g(const torch::Tensor& q, const torch::Tensor& s, const torch::Tensor& sc, const torch::Tensor& cb) {
    TORCH_CHECK(q.is_xpu() && q.scalar_type() == at::kChar && q.dim() == 2 && q.is_contiguous(), "packed W4 int8 [N, K/2]");
    TORCH_CHECK(s.scalar_type() == at::kFloat8_e4m3fn && s.is_contiguous() && s.size(1) * 16 == q.size(1) * 2, "FP8 G16 scales");
    TORCH_CHECK(sc.scalar_type() == at::kFloat && sc.numel() == q.size(0) && cb.scalar_type() == at::kFloat && cb.numel() == 16, "scales");
    return W4{q.data_ptr<int8_t>(), reinterpret_cast<const fp8*>(s.data_ptr()), sc.data_ptr<float>(), cb.data_ptr<float>(),
              q.size(0), q.size(1) * 2};
}

struct GScratch {
    torch::Tensor q1, q2, s, xn, proj, z, ab, core, x1, h, cnt, dbg;
    torch::Tensor abpart;  // a / b linear partials: [4 tiles x 16 K-partials][8 rows x 16 cols], FP32
};
GScratch& gscratch(const torch::Tensor& like) {
    static std::map<int, GScratch> cache;
    const int dev = like.get_device();
    auto found = cache.find(dev);
    if (found == cache.end()) {
        auto o = like.options();
        auto bf = o.dtype(at::kBFloat16);
        GScratch sc{torch::zeros({8, MAXK}, o.dtype(at::kChar)), torch::zeros({8, MAXK}, o.dtype(at::kChar)),
                    torch::zeros({32}, o.dtype(at::kFloat)), torch::zeros({8, 4096}, bf), torch::zeros({8, 8192}, bf),
                    torch::zeros({8, 4096}, bf), torch::zeros({2, 8, 32}, bf), torch::zeros({8, 4096}, bf),
                    torch::zeros({8, 4096}, bf), torch::zeros({8, MAXK}, bf), torch::zeros({4}, o.dtype(at::kInt)),
                    torch::zeros({64 * 16}, o.dtype(at::kLong)), torch::zeros({64 * 128}, o.dtype(at::kFloat))};
        found = cache.emplace(dev, sc).first;
    }
    return found->second;
}

// a[i] for a small register array and a dynamic index (a select chain, no indirect register access)
template <typename V, int N>
inline V pick(const V (&a)[N], int i) {
    V v = a[0];
#pragma unroll
    for (int k = 1; k < N; ++k) v = i == k ? a[k] : v;
    return v;
}

template <bool POST> class LayerGdnKernel;
}  // namespace

torch::Tensor layer_gdn(torch::Tensor x, torch::Tensor norm_in, double eps_in, torch::Tensor hadamard,
                        std::vector<torch::Tensor> w4, torch::Tensor wa, torch::Tensor wb, torch::Tensor conv_w,
                        torch::Tensor conv_state, torch::Tensor proj_buf, torch::Tensor qkv_buf, torch::Tensor ctl,
                        torch::Tensor dt_bias, torch::Tensor g_decay, torch::Tensor rec_state, torch::Tensor gates_buf,
                        torch::Tensor sums_buf, torch::Tensor gnorm_w, double gnorm_eps, double qscale, int64_t hk,
                        torch::Tensor norm_post, double eps_post, torch::Tensor silu_lut, int64_t nwg, int64_t stop, bool tiled) {
    using T = bf16;
    TORCH_CHECK(x.is_xpu() && x.scalar_type() == at::kBFloat16 && x.is_contiguous() && x.size(-1) == 4096, "x bf16 [..., 4096]");
    const int R = static_cast<int>(x.numel() / 4096);
    TORCH_CHECK(R >= 1 && R <= SLOT, "1..8 rows");
    TORCH_CHECK(w4.size() == 24, "W4: qkv, z, out, gate, up, down (q, s, sc, cb each)");
    const W4 QKV = w4g(w4[0], w4[1], w4[2], w4[3]), Z = w4g(w4[4], w4[5], w4[6], w4[7]), O = w4g(w4[8], w4[9], w4[10], w4[11]);
    const W4 G = w4g(w4[12], w4[13], w4[14], w4[15]), U = w4g(w4[16], w4[17], w4[18], w4[19]), Dn = w4g(w4[20], w4[21], w4[22], w4[23]);
    const int HV = static_cast<int>(rec_state.size(1)), HK = static_cast<int>(hk), KD = HK * DH, C = static_cast<int>(QKV.n);
    const int W = static_cast<int>(conv_state.size(2));
    TORCH_CHECK(W == CW, "conv kernel size 4");
    TORCH_CHECK(QKV.k == 4096 && Z.k == 4096 && Z.n == HV * DH && O.k == HV * DH && O.n == 4096 && C == 2 * KD + HV * DH, "GDN shapes");
    TORCH_CHECK(G.k == 4096 && U.n == G.n && Dn.k == G.n && Dn.n == 4096 && G.n <= MAXK && HV * DH == 4096, "MLP shapes");
    TORCH_CHECK(rec_state.scalar_type() == at::kFloat && rec_state.is_contiguous() && rec_state.size(2) == DH && rec_state.size(3) == DH, "state");
    TORCH_CHECK(conv_state.scalar_type() == at::kBFloat16 && conv_state.is_contiguous() && conv_state.size(1) == C, "conv state");
    TORCH_CHECK(conv_w.numel() == int64_t(C) * (W + 1) && conv_w.scalar_type() == at::kBFloat16 && conv_w.is_contiguous(), "conv weight");
    TORCH_CHECK(wa.scalar_type() == at::kBFloat16 && wa.is_contiguous() && wa.size(0) == HV && wa.size(1) == 4096 && wb.sizes() == wa.sizes(), "w_a/w_b");
    TORCH_CHECK(HV == 32 && HK > 0 && HV % HK == 0, "32 value heads");
    TORCH_CHECK(ctl.scalar_type() == at::kInt && ctl.numel() == 2 + 3 * SLOT, "ctl");
    auto& S = gscratch(x);
    auto& queue = c10::xpu::getCurrentXPUStream().queue();
    int64_t cores = queue.get_device().get_info<sycl::info::device::max_compute_units>() / 8;
    if (nwg <= 0 || nwg > cores) nwg = cores;
    const uint32_t NW = static_cast<uint32_t>(nwg);
    TORCH_CHECK(NW * MWG >= uint32_t(C + SLOT * HV), "conv threads");
    const W4 pre[2] = {QKV, Z}, gu[2] = {G, U};
    Stream SP = make_stream(pre, 2, false), SO = make_stream(&O, 1, false), SG = make_stream(gu, 2, true), SD = make_stream(&Dn, 1, false);
    stream_finalize(SG, NW);
    for (Stream* st : {&SP, &SO, &SG, &SD}) {
        st->tiled = tiled;
        int64_t a0, a1;
        stream_range(*st, 0, NW, a0, a1);
        TORCH_CHECK((a1 - a0) * 128 <= ACC, "SLM accumulators");
        st->ksplit = choose_ksplit(a1 - a0, st->m[0].k);
    }
    auto* xp = reinterpret_cast<T*>(x.data_ptr());
    const auto* nin = reinterpret_cast<const T*>(norm_in.data_ptr());
    const auto* npost = reinterpret_cast<const T*>(norm_post.data_ptr());
    const auto* hp = reinterpret_cast<const T*>(hadamard.data_ptr());
    const auto* lut = reinterpret_cast<const T*>(silu_lut.data_ptr());
    const auto* wap = reinterpret_cast<const T*>(wa.data_ptr());
    const auto* wbp = reinterpret_cast<const T*>(wb.data_ptr());
    const auto* cw = reinterpret_cast<const T*>(conv_w.data_ptr());
    auto* cst = reinterpret_cast<T*>(conv_state.data_ptr());
    auto* pb = reinterpret_cast<T*>(proj_buf.data_ptr());
    auto* qb = reinterpret_cast<T*>(qkv_buf.data_ptr());
    const int* control = ctl.data_ptr<int>();
    const float* dp = dt_bias.data_ptr<float>();
    const float* gdp = g_decay.data_ptr<float>();
    float* rs = rec_state.data_ptr<float>();
    const int64_t RS_BYTES = rec_state.numel() * 4;
    float* gatesp = gates_buf.data_ptr<float>();
    float* sumsp = sums_buf.data_ptr<float>();
    const auto* gnw = reinterpret_cast<const T*>(gnorm_w.data_ptr());
    auto* q1p = S.q1.data_ptr<int8_t>();
    auto* q2p = S.q2.data_ptr<int8_t>();
    auto* sp = S.s.data_ptr<float>();
    auto* xnp = reinterpret_cast<T*>(S.xn.data_ptr());
    auto* projp = reinterpret_cast<T*>(S.proj.data_ptr());
    auto* zp = reinterpret_cast<T*>(S.z.data_ptr());
    auto* abg = S.abpart.data_ptr<float>();
    auto* corep = reinterpret_cast<T*>(S.core.data_ptr());
    auto* x1p = reinterpret_cast<T*>(S.x1.data_ptr());
    auto* hb = reinterpret_cast<T*>(S.h.data_ptr());
    auto* cnt = reinterpret_cast<uint32_t*>(S.cnt.data_ptr());
    auto* dbg = reinterpret_cast<uint64_t*>(S.dbg.data_ptr());
    const float e_in = static_cast<float>(eps_in), e_post = static_cast<float>(eps_post);
    const float sc = static_cast<float>(qscale), epsilon = static_cast<float>(gnorm_eps);
    const int64_t N1 = G.n;
    const int ST = static_cast<int>(stop % 100);  // stop: last phase (debug); +200 enables the L2 warm-up
    // L2 warm-up budgets per work-group (bytes); stop >= 100 disables (experiments)
    const bool PF_ON = stop >= 200;  // L2 warm-up experiment: blocking prefetch issue cost more than it saved
    // POST = false compiles only P1-P5 (norm .. GDN core -> core); the post block then runs as
    // layer_post. The full kernel spills ~1 KB per thread at 128 GRF, the split halves do not.
    auto launch = [&](auto post_tag) {
    constexpr bool POST = decltype(post_tag)::value;
    queue.submit([&](sycl::handler& cgh) {
        sycl::local_accessor<uint32_t, 1> region(TAB / 2, cgh);
        sycl::local_accessor<float, 1> red(MSG, cgh);
        sycl::local_accessor<float, 1> nred(1056, cgh);
        sycl::local_accessor<int32_t, 1> acc(ACC, cgh);
        sycl::local_accessor<float, 1> cbl(16, cgh);
        // P5: double-buffered row-group partials of the delta rule's memory (k . S) and output (q . S)
        sycl::local_accessor<float, 1> mbuf(2 * RG * DH, cgh), rbuf(2 * RG * DH, cgh);
        sycl::local_accessor<float, 1> misc(128, cgh);  // P5: entry gates [0, 32), parity-p gates [32, 48),
                                                        // parity-p sums [48, 64), output row sums [64, 72)
        sycl::local_accessor<int, 1> cts(NCTL, cgh);  // ctl in SLM (read after the first grid_sync)
        cgh.parallel_for<LayerGdnKernel<POST>>(
            sycl::nd_range<1>(NW * MWG, MWG), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
                auto sg = it.get_sub_group();
                const int t = it.get_local_id(0), lane = sg.get_local_id()[0], sgi = sg.get_group_id()[0];
                const uint32_t wg = it.get_group(0);
                const int gid = int(wg) * MWG + t;
                uint32_t epoch = 0;
                uint32_t* rraw = region.template get_multi_ptr<sycl::access::decorated::no>().get();
                const LPtrF xr = lptr(reinterpret_cast<float*>(rraw));
                const LPtrU16 tab = lptr(reinterpret_cast<uint16_t*>(rraw));
                auto lacc = lptr(acc.template get_multi_ptr<sycl::access::decorated::no>().get());
                auto lred = lptr(nred.template get_multi_ptr<sycl::access::decorated::no>().get());
                if (t < 16) cbl[t] = QKV.cb[t];  // one codebook for every projection (host-checked)
                if (t < NCTL) cts[t] = control[t];
                // P1's cold operands do not survive the previous launch's weight stream in L2: the Hadamard
                // matrix (128 KB, rot_quant's B, first read after the norm, ~3 us in) and the a / b weights
                // (512 KB, read once xn is published): request them now
                {
                    namespace syclex = sycl::ext::oneapi::experimental;
                    auto pf = [&](const void* base, int64_t bytes) {
                        for (int64_t off = int64_t(gid) * 64; off < bytes; off += int64_t(NW) * MWG * 64)
                            syclex::prefetch(const_cast<char*>(static_cast<const char*>(base)) + off,
                                             syclex::properties{syclex::prefetch_hint_L2});
                    };
                    pf(hp, int64_t(GS) * GS * 2);
                    pf(wap, int64_t(HV) * 4096 * 2);
                    pf(wbp, int64_t(HV) * 4096 * 2);
                }
                const SlmCb cb{cbl, 0};
                bool tab_ok = false;
                auto table = [&]() {
                    if (!tab_ok) { build_pair_table(it, tab, cb); tab_ok = true; }
                    sycl::group_barrier(it.get_group());
                };
                auto gemv = [&](const Stream& st, const int8_t* xq, int64_t& t0, int64_t& t1) {
                    stream_range(st, wg, NW, t0, t1);
                    table();
                    for (int64_t i = t; i < (t1 - t0) * 128; i += MWG) acc[i] = 0;
                    sycl::group_barrier(it.get_group());
                    stream_gemv(it, xq, st, t0, t1, tab, lacc);
                    sycl::group_barrier(it.get_group());
                };
                if (t == 0) dbg[wg * 16] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                const int p = control[1], pending = control[0];
                const bool ctl_ok = p >= 0 && p <= 1 && pending >= 0 && pending <= SLOT;
                // ---- P1: xn = RMSNorm(x); q1 = rot_quant(xn) | a, b = xn W_a^T, xn W_b^T ----
                if (PF_ON && int(wg) >= R) prefetch_stream(it, SP, wg, NW, PF_P1);
                for (int r = wg; r < R; r += NW) {
                    rms_norm_row(it, xp + r * 4096, nin, xnp + r * 4096, e_in, lred);
                    // publish row r of xn to the a / b sub-groups (they run while the rows are rotated)
                    sycl::atomic_fence(sycl::memory_order::acq_rel, sycl::memory_scope::device);
                    sycl::group_barrier(it.get_group());
                    if (t == 0)
                        sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                         sycl::access::address_space::global_space>(cnt[2]).fetch_add(1u);
                    rot_quant_row(it, xnp + r * 4096, hp, q1p + r * 4096, sp + r, 4096, xr, red);
                    tab_ok = false;
                }
                // a, b BF16 linear in oneDNN order: 4 tiles (a: 2, b: 2) x 16 partial accumulators; partial j sums
                // the K32 chunks j, j + 16, ... in order (the final, sequential sum of the 16 partials is done per
                // head at the start of P5). The 64 (tile, partial) units run on the last sub-groups of the last
                // 16 work-groups (no rows there for R <= NW - 16) as soon as all R rows of xn are published,
                // in the shadow of rot_quant (one work-group reading all 512 KB in P3 took ~10 us)
                {
                    const int nab = int(NW) < 16 ? int(NW) : 16, upw = (64 + nab - 1) / nab;  // work-groups, units each
                    const int usg = sgi - (MWG / 16 - upw), unit = (int(NW) - 1 - int(wg)) * upw + usg;
                    if (int(wg) >= int(NW) - nab && usg >= 0 && unit < 64) {
                        if (lane == 0) {
                            sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                             sycl::access::address_space::global_space> rows(cnt[2]);
                            while (rows.fetch_add(0u) < uint32_t(R)) {  // RMW poll (see grid_sync)
                            }
                        }
                        sycl::group_barrier(sg);
                        sycl::atomic_fence(sycl::memory_order::acq_rel, sycl::memory_scope::device);
                        const int tile = unit / 16, j = unit % 16;
                        const T* w = (tile < 2 ? wap : wbp) + int64_t(tile & 1) * 16 * 4096;
                        // 8 K32 chunks x 2 K16 steps, accumulated in order; the loads of 4 steps are in flight together
                        jm::joint_matrix<sycl::sub_group, T, jm::use::a, 8, 16, jm::layout::row_major> a[4];
                        jm::joint_matrix<sycl::sub_group, T, jm::use::b, 16, 16, jm::layout::col_major> b[4];
                        jm::joint_matrix<sycl::sub_group, float, jm::use::accumulator, 8, 16> c;
                        jm::joint_matrix_fill(sg, c, 0.f);
                        for (int q = 0; q < 16; q += 4) {
#pragma unroll
                            for (int u = 0; u < 4; ++u) {
                                const int k = (j + 16 * ((q + u) / 2)) * 32 + 16 * ((q + u) % 2);
                                jm::joint_matrix_load(sg, a[u], gptr(xnp + k), 4096);
                                jm::joint_matrix_load(sg, b[u], gptr(w + k), 4096);
                            }
#pragma unroll
                            for (int u = 0; u < 4; ++u) jm::joint_matrix_mad(sg, c, a[u], b[u], c);
                        }
                        jm::joint_matrix_store(sg, c, gptr(abg + (tile * 16 + j) * 128), 16, jm::layout::row_major);
                    }
                }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 1] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P2: proj, z ----
                {
                    int64_t t0, t1;
                    gemv(SP, q1p, t0, t1);
                    // P3 and P5 read cold per-layer data on latency-bound paths (the 2 MB recurrent state, conv
                    // state and weights, the previous step's accepted projection rows and q / k / v, the gate
                    // and norm parameters): requested into L2 once this work-group's GEMV share is done (one or two
                    // lines per thread). Prefetches are not free: the issuing thread's next device-scope fence
                    // waits for them, and halfway through the GEMV they cost the stream more than they saved.
                    {
                        namespace syclex = sycl::ext::oneapi::experimental;
                        const int64_t g = int64_t(wg) * MWG + t, all = int64_t(NW) * MWG;
                        auto pf = [&](const void* base, int64_t bytes) {
                            for (int64_t off = g * 64; off < bytes; off += all * 64)
                                syclex::prefetch(const_cast<char*>(static_cast<const char*>(base)) + off,
                                                 syclex::properties{syclex::prefetch_hint_L2});
                        };
                        pf(rs, RS_BYTES);
                        pf(cst, int64_t(C) * CW * 2);
                        pf(cw, int64_t(C) * (CW + 1) * 2);
                        pf(qb + int64_t(1 - p) * C * SLOT, int64_t(C) * SLOT * 2);
                        if (ctl_ok)
                            for (int r = pending > CW ? pending - CW : 0; r < pending; ++r)
                                pf(pb + (int64_t(1 - p) * SLOT + cts[2 + r]) * C, int64_t(C) * 2);
                        pf(gatesp + int64_t(1 - p) * SLOT * HV * 2, SLOT * HV * 2 * 4);
                        pf(sumsp + int64_t(1 - p) * SLOT * HK * 2, SLOT * HK * 2 * 4);
                        pf(dp, HV * 4);
                        pf(gdp, HV * 4);
                        pf(gnw, DH * 2);
                    }
                    for (int64_t i = t; i < (t1 - t0) * 128; i += MWG) {
                        const int e2 = i % 128, r = e2 / 16;
                        if (r >= R) continue;
                        int tile;
                        const int m = stream_which(SP, int(t0 + i / 128), tile);
                        const int64_t n = int64_t(tile) * 16 + e2 % 16;
                        if (m == 0) projp[r * C + n] = scaleback(acc[i], sp[r], QKV.sc[n]);
                        else zp[r * 4096 + n] = scaleback(acc[i], sp[r], Z.sc[n]);
                    }
                }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 2] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P3: deferred conv ----
                // conv, one (channel, pair of tree slots) per thread: the per-slot arithmetic (exp, IEEE division)
                // of 8 slots on one thread was ~2.5 us of ALU; inputs are cold or just written, so they are all
                // requested before use (ctl is in SLM); the arithmetic is the original's, in its order
                if (ctl_ok) {
                    const int64_t all = int64_t(NW) * MWG, current = int64_t(p) * SLOT * C, previous = int64_t(1 - p) * SLOT * C;
                    for (int64_t i = gid; i < int64_t(C) * SLOT; i += all)  // this step's rows, zero beyond R
                        pb[current + i] = i < int64_t(R) * C ? projp[i] : T(0.f);
                    for (int64_t i = gid; i < int64_t(C) * (SLOT / 2); i += all) {
                        const int c = int(i / (SLOT / 2)), tp = int(i % (SLOT / 2)), n = pending;
                        T* history = cst + int64_t(c) * CW;
                        T old[CW], hist[CW];
                        float w[CW + 1];
#pragma unroll
                        for (int r = 0; r < CW; ++r) old[r] = history[r];
#pragma unroll
                        for (int d = 0; d <= CW; ++d) w[d] = float(cw[int64_t(c) * (CW + 1) + d]);
                        // the conv state shifted by the previous step's accepted tokens
#pragma unroll
                        for (int r = 0; r < CW; ++r) {
                            const int accepted = n + r - CW;
                            const int slot = accepted >= 0 ? cts[2 + accepted] : 0;
                            hist[r] = n + r < CW ? pick(old, n + r) : pb[previous + int64_t(slot) * C + c];
                        }
                        uint32_t packed = 0;
#pragma unroll
                        for (int h = 0; h < 2; ++h) {
                            const int ts = 2 * tp + h;
                            T out = T(0.f);
                            if (ts < R) {
                                int anc[CW + 1], missing[CW + 1];
                                anc[0] = ts; missing[0] = 0;
#pragma unroll
                                for (int d = 1; d <= CW; ++d) {
                                    anc[d] = anc[d - 1] >= 0 ? cts[2 + SLOT + anc[d - 1]] : -1;
                                    missing[d] = missing[d - 1] + (anc[d] < 0);
                                }
                                T v[CW + 1];
#pragma unroll
                                for (int d = 0; d <= CW; ++d)
                                    v[d] = anc[d] >= 0 ? projp[int64_t(anc[d]) * C + c] : pick(hist, CW - missing[d]);
                                float sum = 0.f;
#pragma unroll
                                for (int d = 0; d <= CW; ++d) sum = sycl::fma(float(v[d]), w[CW - d], sum);
                                const float y = float(T(sum));
                                out = T(y / (1.f + sycl::exp(-y)));
                            }
                            packed |= uint32_t(sycl::bit_cast<uint16_t>(out)) << (16 * h);
                        }
                        *reinterpret_cast<uint32_t*>(qb + (int64_t(p) * C + c) * SLOT + 2 * tp) = packed;
                        if (tp == 0)
#pragma unroll
                            for (int r = 0; r < CW; ++r) history[r] = hist[r];
                    }
                }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 3] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P5: replay accepted + verify, one value head per work-group (threads 0..511) ----
                if (PF_ON) { prefetch_stream(it, SO, wg, NW, PF_O); prefetch_stream(it, SG, wg, NW, PF_G); }
#ifndef GDN_NO_DELTA
                for (int head = wg; head < HV && ctl_ok; head += NW) {
                    const int kh = head / (HV / HK);
                    const bool act = t < RG * DH;
                    const int col = t % DH, rg = (t / DH) % RG;
                    const int64_t base = (int64_t(head) * DH + rg * RPG) * DH + col;
                    float st[RPG];  // the recurrent state (64 KB per work-group)
                    for (int r = 0; r < RPG; ++r) st[r] = act ? rs[base + r * DH] : 0.f;
                    // the gated norm's inputs of output row (t / DH, col)
                    const int ots = t / DH;
                    const int64_t odst = (int64_t(ots) * HV + head) * DH + col;
                    const float ozz = ots < R ? float(zp[odst]) : 0.f, ogw = float(gnw[col]);
                    auto slm = lptr(reinterpret_cast<float*>(acc.template get_multi_ptr<sycl::access::decorated::no>().get()));
                    auto vals = slm;                 // [q|k][ts][d], parity p (2 * SLOT * DH)
                    auto kvec = slm + 2 * SLOT * DH;  // [entry][d]: k * ki (2 * SLOT * DH)
                    auto qvec = slm + 4 * SLOT * DH;  // [verify entry][d]: (q * scale) * qi (SLOT * DH)
                    auto vvec = slm + 5 * SLOT * DH;  // [entry][d]: v (2 * SLOT * DH)
                    auto rawb = slm + 7 * SLOT * DH;  // [ts][d]: the delta rule's output rows (SLOT * DH)
                    // the entry list: phase 0 replays the previous step's accepted slots (parity 1 - p, always
                    // committed), phase 1 runs this step's verify instructions (parity p); an invalid slot ends
                    // the list there (in phase 0 nothing is written then)
                    int E0 = 0, E1 = 0;
                    while (E0 < pending && cts[2 + E0] >= 0 && cts[2 + E0] < SLOT) ++E0;
                    const bool replayed = E0 == pending;
                    if (replayed)
                        while (E1 < R && (cts[2 + 2 * SLOT + E1] & 15) < R && cts[2 + 2 * SLOT + E1] >= 0) ++E1;
                    const int E = E0 + E1;
                    auto slot_of = [&](int e) { return e < E0 ? cts[2 + e] : (cts[2 + 2 * SLOT + e - E0] & 15); };
                    {
#pragma clang fp reassociate(off) contract(off)
                    // the replayed entries' inputs (previous step's buffers) do not depend on the prologue
                    if (t < E0) {
                        const int64_t gate = (int64_t(1 - p) * SLOT + slot_of(t)) * HV + head;
                        misc[t * 2] = gatesp[gate * 2];
                        misc[t * 2 + 1] = gatesp[gate * 2 + 1];
                    }
                    for (int i = t; i < E0 * DH; i += MWG) {
                        const int e = i / DH, d = i % DH, ts = slot_of(e);
                        const int64_t qbbase = int64_t(1 - p) * C * SLOT, ss = (int64_t(1 - p) * SLOT + ts) * HK + kh;
                        const float ki = 1.f / sycl::fmax(sycl::sqrt(sumsp[ss * 2 + 1]), 1e-12f);
                        kvec[i] = float(qb[qbbase + (KD + kh * DH + d) * SLOT + ts]) * ki;
                        vvec[i] = float(qb[qbbase + (2 * KD + head * DH + d) * SLOT + ts]);
                    }
                    }
                    // prologue: this head's gates and its key head's q/k sums of squares for parity p
                    // (Kitchen gates / sums kernels; the two heads of a key head write identical sums)
                    // (gates on sub-group 32, sums on sub-group 0: the two chains run side by side)
                    if (t >= MWG / 2 && t < MWG / 2 + SLOT) {
                        const int ts = t - MWG / 2;
                        const int64_t dst = (int64_t(p) * SLOT + ts) * HV + head;
                        float decay = 0, beta = 0;
                        if (ts < R) {
                            // a / b for this head: the 16 K-partials summed in order, rounded to T (all 32
                            // partials are requested first: a load-add loop issued them one at a time, ~7 us)
                            const int el = ts * 16 + head % 16;
                            float part[2][16];
#pragma unroll
                            for (int which = 0; which < 2; ++which)
#pragma unroll
                                for (int q = 0; q < 16; ++q) part[which][q] = abg[((which * 2 + head / 16) * 16 + q) * 128 + el];
                            const float dph = dp[head], gdh = gdp[head];
                            auto ab = [&](int which) {
                                float acc_ab = part[which][0];
#pragma unroll
                                for (int q = 1; q < 16; ++q) acc_ab = acc_ab + part[which][q];
                                return float(static_cast<T>(acc_ab));
                            };
                            const float av = ab(0) + dph, bv = ab(1);
                            const float softplus = av > 20.f ? av : sycl::log(1.f + sycl::exp(av));
                            decay = sycl::exp(gdh * softplus);
                            beta = float(T(1.f / (1.f + sycl::exp(-bv))));
                        }
                        gatesp[dst * 2] = decay;
                        gatesp[dst * 2 + 1] = beta;
                        misc[32 + ts * 2] = decay;
                        misc[32 + ts * 2 + 1] = beta;
                    }
                    {
                        for (int i = t; i < 2 * SLOT * DH; i += MWG) {
                            const int which = i / (SLOT * DH), ts = (i / DH) % SLOT, d = i % DH;
                            const int64_t src = int64_t(p) * C * SLOT + (int64_t(which) * KD + kh * DH + d) * SLOT + ts;
                            vals[i] = ts < R ? float(qb[src]) : 0.f;
                        }
                        sycl::group_barrier(it.get_group());
                        if (t < 2 * SLOT) {
                            const int which = t / SLOT, ts = t % SLOT;
                            float acc2 = 0;
                            if (ts < R)
#pragma unroll 8
                                for (int d4 = 0; d4 < DH / 4; ++d4) {  // in order, four values per SLM load
                                    sycl::vec<float, 4> v;
                                    v.load(d4, vals + (which * SLOT + ts) * DH);
                                    acc2 = sycl::fma(v[0], v[0], acc2);
                                    acc2 = sycl::fma(v[1], v[1], acc2);
                                    acc2 = sycl::fma(v[2], v[2], acc2);
                                    acc2 = sycl::fma(v[3], v[3], acc2);
                                }
                            sumsp[((int64_t(p) * SLOT + ts) * HK + kh) * 2 + which] = acc2;
                            misc[48 + ts * 2 + which] = acc2;
                        }
                        sycl::atomic_fence(sycl::memory_order::acq_rel, sycl::memory_scope::work_group);
                        sycl::group_barrier(it.get_group());
                    }
                    {
#pragma clang fp reassociate(off) contract(off)
                    // the verify entries' inputs (one round trip instead of ~4 per entry)
                    if (t >= E0 && t < E) {
                        const int ts = slot_of(t);
                        misc[t * 2] = misc[32 + ts * 2];
                        misc[t * 2 + 1] = misc[32 + ts * 2 + 1];
                    }
                    for (int i = E0 * DH + t; i < E * DH; i += MWG) {
                        const int e = i / DH, d = i % DH, ts = slot_of(e);
                        const float qi = 1.f / sycl::fmax(sycl::sqrt(misc[48 + ts * 2]), 1e-12f);
                        const float ki = 1.f / sycl::fmax(sycl::sqrt(misc[48 + ts * 2 + 1]), 1e-12f);
                        kvec[i] = vals[(SLOT + ts) * DH + d] * ki;
                        qvec[(e - E0) * DH + d] = (vals[ts * DH + d] * sc) * qi;
                        vvec[i] = float(qb[int64_t(p) * C * SLOT + (2 * KD + head * DH + d) * SLOT + ts]);
                    }
                    sycl::group_barrier(it.get_group());
                    // the output row of verify entry e from its four row-group partials
                    auto finish = [&](int e) {
                        const int rb = (e & 1) * RG * DH + col;  // (accessor indexing keeps the loads in SLM)
                        rawb[slot_of(e) * DH + col] = float(T(rbuf[rb] + rbuf[rb + DH] + rbuf[rb + 2 * DH] + rbuf[rb + 3 * DH]));
                    };
                    // entry e's inputs; entry e + 1's are requested before entry e's barrier
                    static_assert(RPG == 32, "two 16-lane loads per row group");
                    struct In { float k_lo, k_hi, q_lo, q_hi, decay, beta, value; bool commit; };
                    auto inputs = [&](int e) {
                        In in{};
                        const bool verify = e >= E0;
                        in.commit = !verify || (cts[2 + 2 * SLOT + e - E0] & 32);
                        in.decay = misc[e * 2];
                        in.beta = misc[e * 2 + 1];
                        if (act) {
                            // k[rg * RPG + r] / q[...] are uniform in a sub-group: lane-parallel loads, then broadcasts
                            in.k_lo = kvec[e * DH + rg * RPG + lane];
                            in.k_hi = kvec[e * DH + rg * RPG + 16 + lane];
                            const int qrow = (verify ? e - E0 : 0) * DH + rg * RPG;
                            in.q_lo = qvec[qrow + lane];
                            in.q_hi = qvec[qrow + 16 + lane];
                            in.value = vvec[e * DH + col];
                        }
                        return in;
                    };
                    In cur = E > 0 ? inputs(0) : In{};
                    for (int e = 0; e < E; ++e) {
                        const bool verify = e >= E0, commit = cur.commit;
                        const float decay = cur.decay, beta = cur.beta;
                        // a non-committing entry leaves the state as it is: its decayed / updated rows are
                        // recomputed into temporaries (same operations; no SLM snapshot of 32 rows)
                        float memory = 0;
                        if (act && commit)
#pragma unroll
                            for (int r = 0; r < RPG; ++r) {
                                st[r] = st[r] * decay;
                                memory = sycl::fma(st[r], sycl::group_broadcast(sg, r < 16 ? cur.k_lo : cur.k_hi, r % 16), memory);
                            }
                        if (act && !commit)
#pragma unroll
                            for (int r = 0; r < RPG; ++r) {
                                const float sd = st[r] * decay;
                                memory = sycl::fma(sd, sycl::group_broadcast(sg, r < 16 ? cur.k_lo : cur.k_hi, r % 16), memory);
                            }
                        const int mb = (e & 1) * RG * DH + col;
                        if (act) mbuf[mb + rg * DH] = memory;
                        const In next = e + 1 < E ? inputs(e + 1) : In{};
                        sycl::group_barrier(it.get_group());  // the only barrier per entry (buffers alternate)
                        if (e > E0 && act && rg == 0) finish(e - 1);
                        if (act) {
                            const float kv = mbuf[mb] + mbuf[mb + DH] + mbuf[mb + 2 * DH] + mbuf[mb + 3 * DH];
                            const float delta = (cur.value - kv) * beta;
                            float result = 0;
                            if (commit)
#pragma unroll
                                for (int r = 0; r < RPG; ++r) {
                                    st[r] = sycl::fma(sycl::group_broadcast(sg, r < 16 ? cur.k_lo : cur.k_hi, r % 16), delta, st[r]);
                                    if (verify) result = sycl::fma(st[r], sycl::group_broadcast(sg, r < 16 ? cur.q_lo : cur.q_hi, r % 16), result);
                                }
                            else  // (a verify entry)
#pragma unroll
                                for (int r = 0; r < RPG; ++r) {
                                    const float sd = st[r] * decay;
                                    const float u = sycl::fma(sycl::group_broadcast(sg, r < 16 ? cur.k_lo : cur.k_hi, r % 16), delta, sd);
                                    result = sycl::fma(u, sycl::group_broadcast(sg, r < 16 ? cur.q_lo : cur.q_hi, r % 16), result);
                                }
                            if (verify) rbuf[(e & 1) * RG * DH + rg * DH + col] = result;
                        }
                        if (e == E0 - 1 && replayed && act)  // the committed state after the replay
                            for (int r = 0; r < RPG; ++r) rs[base + r * DH] = st[r];
                        cur = next;
                    }
                    sycl::group_barrier(it.get_group());
                    if (E1 > 0 && act && rg == 0) finish(E - 1);
                    // gated RMSNorm of every output row at once: thread (ts, col) = (t / DH, t % DH)
                    uint32_t written = 0;
                    for (int e = E0; e < E; ++e) written |= 1u << slot_of(e);
                    sycl::group_barrier(it.get_group());
                    const bool out = (written >> ots) & 1;
                    const float raw = out ? rawb[ots * DH + col] : 0.f;
                    auto square = vals;  // [ts][d]
                    square[ots * DH + col] = raw * raw;
                    sycl::group_barrier(it.get_group());
                    // Kitchen's halving tree over 128 squares (strides 64 .. 1), sub-group ts for row ts:
                    // lane j holds columns j + 16k, so strides 64/32/16 are lane-local and 8..1 shuffles
                    if (sgi < SLOT && ((written >> sgi) & 1)) {
                        float v[8];
#pragma unroll
                        for (int k = 0; k < 8; ++k) v[k] = square[sgi * DH + lane + 16 * k];
#pragma unroll
                        for (int k = 0; k < 4; ++k) v[k] = v[k] + v[k + 4];
#pragma unroll
                        for (int k = 0; k < 2; ++k) v[k] = v[k] + v[k + 2];
                        float a = v[0] + v[1];
                        a = a + sycl::shift_group_left(sg, a, 8);
                        a = a + sycl::shift_group_left(sg, a, 4);
                        a = a + sycl::shift_group_left(sg, a, 2);
                        a = a + sycl::shift_group_left(sg, a, 1);
                        if (lane == 0) misc[64 + sgi] = a;
                    }
                    sycl::group_barrier(it.get_group());
                    if (out) {
                        const float rsq = hw_rsqrt(misc[64 + ots] / DH + epsilon);
                        const float rw = raw * ogw;
                        const float normed = float(T(rw * rsq));
                        const float gate_z = float(T(ozz / (1.f + sycl::exp(-ozz))));
                        corep[odst] = T(normed * gate_z);
                    }
                    sycl::group_barrier(it.get_group());
                    }
                    tab_ok = false;
                }
#endif
                if constexpr (POST) {
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 5] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P6: q1 = rot_quant(core) ----
                if (ST >= 6)
                    for (int r = wg; r < R; r += NW) {
                        rot_quant_row(it, corep + r * 4096, hp, q1p + r * 4096, sp + r, 4096, xr, red);
                        tab_ok = false;
                    }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 6] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P7: x1 = x + out_proj(q1) ----
                if (ST >= 7) {
                    int64_t t0, t1;
                    gemv(SO, q1p, t0, t1);
                    for (int64_t i = t; i < (t1 - t0) * 128; i += MWG) {
                        const int e2 = i % 128, r = e2 / 16;
                        if (r >= R) continue;
                        const int64_t n = (t0 + i / 128) * 16 + e2 % 16;
                        x1p[r * 4096 + n] = bf16_add(xp[r * 4096 + n], scaleback(acc[i], sp[r], O.sc[n]));
                    }
                }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 7] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P8: q1 = rot_quant(RMSNorm(x1)) ----
                if (ST >= 8)
                    for (int r = wg; r < R; r += NW) {
                        rms_norm_row(it, x1p + r * 4096, npost, xnp + r * 4096, e_post, lred);
                        rot_quant_row(it, xnp + r * 4096, hp, q1p + r * 4096, sp + 8 + r, 4096, xr, red);
                        tab_ok = false;
                    }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 8] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P9: h = silu(gate) * up ----
                if (ST >= 9) {
                    int64_t t0, t1;
                    gemv(SG, q1p, t0, t1);
                    for (int64_t i = t; i < (t1 - t0) / 2 * 128; i += MWG) {
                        const int64_t tl = i / 128;
                        const int e2 = i % 128, r = e2 / 16;
                        if (r >= R) continue;
                        const int64_t n = (t0 / 2 + tl) * 16 + e2 % 16;
                        const T g = scaleback(acc[(2 * tl) * 128 + e2], sp[8 + r], G.sc[n]);
                        const T u = scaleback(acc[(2 * tl + 1) * 128 + e2], sp[8 + r], U.sc[n]);
                        hb[r * N1 + n] = bf16_mul(lut[sycl::bit_cast<uint16_t>(g)], u);
                    }
                }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 9] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P10: q2 = rot_quant(h) ----
                if (PF_ON && int(wg) >= R) prefetch_stream(it, SD, wg, NW, PF_D);
                if (ST >= 10)
                    for (int r = wg; r < R; r += NW) {
                        rot_quant_row(it, hb + r * N1, hp, q2p + r * N1, sp + 16 + r, N1, xr, red);
                        tab_ok = false;
                    }
                grid_sync(it, cnt, NW, epoch);
                if (t == 0) dbg[wg * 16 + 10] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                // ---- P11: x = x1 + down(q2) ----
                if (ST >= 11) {
                    int64_t t0, t1;
                    gemv(SD, q2p, t0, t1);
                    for (int64_t i = t; i < (t1 - t0) * 128; i += MWG) {
                        const int e2 = i % 128, r = e2 / 16;
                        if (r >= R) continue;
                        const int64_t n = (t0 + i / 128) * 16 + e2 % 16;
                        xp[r * 4096 + n] = bf16_add(x1p[r * 4096 + n], scaleback(acc[i], sp[16 + r], Dn.sc[n]));
                    }
                }
                }  // POST
                // barrier counter self-reset
                sycl::group_barrier(it.get_group());
                if (t == 0) dbg[wg * 16 + 11] = sycl::ext::oneapi::experimental::clock<sycl::ext::oneapi::experimental::clock_scope::sub_group>();
                if (t == 0) {
                    sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                     sycl::access::address_space::global_space> done(cnt[1]), c0(cnt[0]);
                    sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                     sycl::access::address_space::global_space> rows(cnt[2]);
                    if (done.fetch_add(1u) == NW - 1) { c0.store(0u); rows.store(0u); done.store(0u); }
                }
            });
    });
    };
    if (ST >= 6) launch(std::true_type{});
    else launch(std::false_type{});
    return x;
}

// the GDN core output of the last layer_gdn launch (rows 0..R-1), input of layer_post
torch::Tensor layer_gdn_core(torch::Tensor like, int64_t rows) {
    return gscratch(like).core.narrow(0, 0, rows);
}
}  // namespace mono_decode_xpu
