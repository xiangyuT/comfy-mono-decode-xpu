// SPDX-License-Identifier: Apache-2.0
// Exact top-k (k <= 64) of a few long rows, one launch: the verify step's sampling filter
// (torch.topk(logits.float(), top_k) over 8 x 248k in ComfyUI's processed_probs; about 270 us in torch
// XPU's sbtopk gather + segmented sort). The rows may be FP32, or the BF16 logits themselves: the result
// is torch.topk of their FP32 values (BF16 -> FP32 is exact).
//
// torch XPU topk on [R, N] FP32 returns, per row, the k largest by the radix key (TopKTypeConfig<float>: the
// sign-flipped bits, so -0 sorts below +0), sorted descending, ties in gather order: iteration i / 32768, then thread
// (i % 4096) / 4, then load (i % 32768) / 4096, then lane i % 4 (1024 threads x 8 vector loads of 4 per
// 32768-element iteration). Checked against torch on tie-heavy, +-0 and NaN rows. A 64-bit rank (radix key,
// then the inverted gather key) orders the elements exactly that way and is unique per row.
//
// Grid: R x 4 work-groups, each owning a quarter of a row. Pass 1: each thread's largest radix key. A
// 16-ary search over the top 16 bits of those 1024 maxima gives a threshold with at least k elements of
// the quarter at or above it. Pass 2 collects those (usually k plus a few) and ranks them: the quarter's
// top-k. If more than 1024 qualify (heavy ties), an exact 16-ary search over the 64-bit rank finds the
// quarter's k-th element instead (slow, correct). The row's last work-group merges the 4 sorted lists.
#include <cstdint>
#include <map>
#include <vector>

#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <torch/extension.h>

namespace mono_decode_xpu {
namespace {
constexpr int TR_WG = 1024, TR_MAXK = 64, TR_CAP = 1024, TR_NSG = TR_WG / 16, TR_NQ = 15, TR_MAXR = 16, TR_NW = 4;

// TopKTypeConfig<float>::convert as torch XPU's sort orders: the sign flip, no NaN case (+NaN sorts on top,
// -NaN at the bottom). Rows with NaN are not reproduced: torch's own top-k there also depends on its gather
// comparisons (a -NaN can join a small top-k at the end).
inline uint32_t tr_key(uint32_t bits) { return bits ^ ((bits & 0x80000000u) ? 0xFFFFFFFFu : 0x80000000u); }
inline uint64_t tr_rank(uint32_t key, uint32_t i) {
    const uint32_t off = i & 32767u;
    const uint32_t g = ((i >> 15) << 15) | (((off & 4095u) >> 2) << 5) | ((off >> 12) << 2) | (off & 3u);
    return (uint64_t(key) << 32) | uint64_t(0xFFFFFFFFu - g);
}
inline int64_t tr_index(uint64_t r) {
    const uint32_t g = 0xFFFFFFFFu - uint32_t(r);
    const uint32_t it = g >> 15, th = (g >> 5) & 1023u, ld = (g >> 2) & 7u, ln = g & 3u;
    return int64_t((it << 15) | (ld << 12) | (th << 2) | ln);
}
template <typename T>
inline uint32_t tr_bits(T v);  // the FP32 bit pattern of an element
template <>
inline uint32_t tr_bits<uint32_t>(uint32_t v) { return v; }
template <>
inline uint32_t tr_bits<uint16_t>(uint16_t v) { return uint32_t(v) << 16; }

template <typename T>
using tr_global = sycl::atomic_ref<T, sycl::memory_order::relaxed, sycl::memory_scope::device,
                                   sycl::access::address_space::global_space>;
template <typename T>
using tr_local = sycl::atomic_ref<T, sycl::memory_order::relaxed, sycl::memory_scope::work_group,
                                  sycl::access::address_space::local_space>;

// work-group sums of 15 per-thread counts (sub-group reduce, then one exchange); all threads get tot[]
template <typename F>
inline void tr_counts(sycl::nd_item<1>& it, const sycl::local_accessor<int, 1>& part, const sycl::local_accessor<int, 1>& tot, F count) {
    auto sg = it.get_sub_group();
    const int t = it.get_local_id(0), sid = int(sg.get_group_linear_id()), lane = int(sg.get_local_linear_id());
#pragma unroll
    for (int q = 0; q < TR_NQ; ++q) {
        const int c = sycl::reduce_over_group(sg, count(q), sycl::plus<int>());
        if (lane == 0) part[sid * TR_NQ + q] = c;
    }
    sycl::group_barrier(it.get_group());
    if (t < TR_NQ) {
        int c = 0;
        for (int s = 0; s < TR_NSG; ++s) c += part[s * TR_NQ + t];
        tot[t] = c;
    }
    sycl::group_barrier(it.get_group());
}
// f(key, i) for every element of [lo, hi): thread t reads 16-byte chunks lo + (t + WG j) * V (4 in flight)
template <typename T, typename F>
inline void tr_visit(const T* xr, int lo, int hi, int t, F f) {
    constexpr int V = 16 / sizeof(T);
    using vec = sycl::vec<T, V>;
    const int nfull = (hi - lo) / V;  // whole chunks (lo is 16-byte aligned: rows and quarters are)
    for (int c0 = t; c0 < nfull; c0 += 4 * TR_WG) {
        vec b[4];
#pragma unroll
        for (int u = 0; u < 4; ++u) {
            const int c = c0 + u * TR_WG;
            if (c < nfull) b[u] = *reinterpret_cast<const vec*>(xr + lo + c * V);
        }
#pragma unroll
        for (int u = 0; u < 4; ++u) {
            const int c = c0 + u * TR_WG;
            if (c < nfull)
#pragma unroll
                for (int e = 0; e < V; ++e) f(tr_key(tr_bits<T>(b[u][e])), lo + c * V + e);
        }
    }
    for (int i = lo + nfull * V + t; i < hi; i += TR_WG) f(tr_key(tr_bits<T>(xr[i])), i);
}

template <typename T>
class TopkRowsKernel;

template <typename T>
void launch(const T* xp, int R, int NN, int K, float* vp, int64_t* ip, uint64_t* partp, uint32_t* cnt) {
    const int SEG = ((NN + TR_NW - 1) / TR_NW + TR_WG - 1) / TR_WG * TR_WG;  // a quarter (16-byte aligned)
    c10::xpu::getCurrentXPUStream().queue().submit([&](sycl::handler& cgh) {
        sycl::local_accessor<int, 1> part(TR_NSG * TR_NQ, cgh);
        sycl::local_accessor<int, 1> tot(TR_NQ, cgh);
        sycl::local_accessor<uint64_t, 1> cand(TR_CAP, cgh);
        sycl::local_accessor<int, 1> ctr(1, cgh);
        sycl::local_accessor<int, 1> last(1, cgh);
        cgh.parallel_for<TopkRowsKernel<T>>(sycl::nd_range<1>(R * TR_NW * TR_WG, TR_WG), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
            const int t = it.get_local_id(0), row = it.get_group(0) / TR_NW, w = it.get_group(0) % TR_NW;
            auto grp = it.get_group();
            const T* xr = xp + int64_t(row) * NN;
            const int lo = w * SEG, hi = sycl::min(NN, lo + SEG);
            // pass 1: this thread's largest key (| 1: 0 means none)
            uint32_t mx = 0;
            tr_visit<T>(xr, lo, hi, t, [&](uint32_t key, int) { mx = sycl::max(mx, key | 1u); });
            // the threshold: the largest 16-bit prefix L with count(max >> 16 >= L) >= k
            uint32_t L = 0;
            for (int s = 12; s >= 0; s -= 4) {
                tr_counts(it, part, tot, [&](int q) { return int((mx >> 16) >= (L | (uint32_t(q + 1) << s))); });
                int qs = 0;
#pragma unroll
                for (int q = 0; q < TR_NQ; ++q) if (tot[q] >= K) qs = q + 1;
                L |= uint32_t(qs) << s;
                sycl::group_barrier(grp);
            }
            const uint32_t thr = L << 16;
            // pass 2: collect the quarter's elements at or above it
            if (t == 0) ctr[0] = 0;
            sycl::group_barrier(grp);
            tr_visit<T>(xr, lo, hi, t, [&](uint32_t key, int i) {
                if (key >= thr) {
                    const int slot = tr_local<int>(ctr[0]).fetch_add(1);
                    if (slot < TR_CAP) cand[slot] = tr_rank(key, uint32_t(i));
                }
            });
            sycl::group_barrier(grp);
            int n = ctr[0];
            if (n > TR_CAP) {
                // heavy ties: the quarter's exact k-th rank by a 16-ary search over 64 bits (re-reading)
                uint64_t P = 0;
                for (int s = 60; s >= 0; s -= 4) {
                    int c[TR_NQ];
#pragma unroll
                    for (int q = 0; q < TR_NQ; ++q) c[q] = 0;
                    for (int i = lo + t; i < hi; i += TR_WG) {
                        const uint64_t r = tr_rank(tr_key(tr_bits<T>(xr[i])), uint32_t(i));
#pragma unroll
                        for (int q = 0; q < TR_NQ; ++q) c[q] += r >= (P | (uint64_t(q + 1) << s));
                    }
                    tr_counts(it, part, tot, [&](int q) { return c[q]; });
                    int qs = 0;
#pragma unroll
                    for (int q = 0; q < TR_NQ; ++q) if (tot[q] >= K) qs = q + 1;
                    P |= uint64_t(qs) << s;
                    sycl::group_barrier(grp);
                }
                if (t == 0) ctr[0] = 0;
                sycl::group_barrier(grp);
                for (int i = lo + t; i < hi; i += TR_WG) {  // exactly k ranks are >= P (ranks are unique)
                    const uint64_t r = tr_rank(tr_key(tr_bits<T>(xr[i])), uint32_t(i));
                    if (r >= P) {
                        const int slot = tr_local<int>(ctr[0]).fetch_add(1);
                        if (slot < TR_CAP) cand[slot] = r;
                    }
                }
                sycl::group_barrier(grp);
                n = sycl::min(ctr[0], TR_CAP);
            }
            // the quarter's sorted top-k (zero-padded) for the row's last work-group
            uint64_t* lists = partp + int64_t(row) * TR_NW * TR_MAXK;
            for (int j = t; j < n; j += TR_WG) {
                const uint64_t v = cand[j];
                int pos = 0;
                for (int q = 0; q < n; ++q) pos += cand[q] > v;
                if (pos < K) tr_global<uint64_t>(lists[w * TR_MAXK + pos]).store(v);
            }
            for (int j = n + t; j < K; j += TR_WG) tr_global<uint64_t>(lists[w * TR_MAXK + j]).store(0ull);
            sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::device);  // the list's stores
            sycl::group_barrier(grp);                                                       // before the count
            if (t == 0) {
                sycl::atomic_fence(sycl::memory_order::acq_rel, sycl::memory_scope::device);
                sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                 sycl::access::address_space::global_space> c(cnt[row]);
                last[0] = c.fetch_add(1u) == uint32_t(TR_NW - 1);
            }
            sycl::group_barrier(grp);
            if (!last[0]) return;
            const int total = TR_NW * TR_MAXK;  // <= the work-group: one entry per thread
            if (t < total) sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::device);
            uint64_t v = 0;
            if (t < total && t % TR_MAXK < K) v = tr_global<uint64_t>(lists[t]).load();
            if (t < total) cand[t] = v;
            sycl::group_barrier(grp);
            if (v) {
                // rank = own position + the entries above v in each other sorted (descending, zero-padded) list
                const int mine = t / TR_MAXK;
                int pos = t % TR_MAXK;
                for (int ww = 0; ww < TR_NW; ++ww) {
                    if (ww == mine) continue;
                    int a = 0, b = K;  // the first index whose entry is below v
                    while (a < b) {
                        const int m = (a + b) >> 1;
                        if (cand[ww * TR_MAXK + m] > v) a = m + 1; else b = m;
                    }
                    pos += a;
                }
                if (pos < K) {
                    const int64_t idx = tr_index(v);
                    ip[int64_t(row) * K + pos] = idx;
                    vp[int64_t(row) * K + pos] = sycl::bit_cast<float>(tr_bits<T>(xr[idx]));
                }
            }
            if (t == 0) tr_global<uint32_t>(cnt[row]).store(0u);
        });
    });
}
}  // namespace

std::vector<torch::Tensor> topk_rows(torch::Tensor x, int64_t k) {
    TORCH_CHECK(x.is_xpu() && (x.scalar_type() == at::kFloat || x.scalar_type() == at::kBFloat16) && x.is_contiguous()
                && x.dim() == 2, "x: contiguous fp32 / bf16 [R, N]");
    const int64_t R = x.size(0), N = x.size(1);
    TORCH_CHECK(R >= 1 && R <= TR_MAXR, "1 <= rows <= 16");
    TORCH_CHECK(k >= 1 && k <= TR_MAXK && N >= int64_t(TR_NW) * TR_WG && N < (int64_t(1) << 31), "1 <= k <= 64, 4096 <= N");
    static_assert(TR_NW * TR_MAXK <= TR_WG && TR_NW * TR_MAXK <= TR_CAP, "merge: one list entry per thread");
    auto values = torch::empty({R, k}, x.options().dtype(at::kFloat));
    auto indices = torch::empty({R, k}, x.options().dtype(at::kLong));
    // per row: 4 sorted lists of k ranks, and a last-work-group counter (reset by the kernel; launches on
    // one stream are ordered)
    static std::map<std::pair<int, int64_t>, torch::Tensor> scratch;
    auto& sc = scratch[{x.get_device(), int64_t(c10::xpu::getCurrentXPUStream().id())}];
    if (!sc.defined()) sc = torch::zeros({TR_MAXR * TR_NW * TR_MAXK + TR_MAXR}, x.options().dtype(at::kLong));
    auto* partp = reinterpret_cast<uint64_t*>(sc.data_ptr());
    auto* cnt = reinterpret_cast<uint32_t*>(partp + TR_MAXR * TR_NW * TR_MAXK);
    if (x.scalar_type() == at::kFloat)
        launch<uint32_t>(reinterpret_cast<const uint32_t*>(x.data_ptr()), int(R), int(N), int(k), values.data_ptr<float>(),
                         indices.data_ptr<int64_t>(), partp, cnt);
    else
        launch<uint16_t>(reinterpret_cast<const uint16_t*>(x.data_ptr()), int(R), int(N), int(k), values.data_ptr<float>(),
                         indices.data_ptr<int64_t>(), partp, cnt);
    return {values, indices};
}
}  // namespace mono_decode_xpu
