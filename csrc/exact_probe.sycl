// Exactness probes for porting eager decode ops into mono kernels (not used by the decode path).
//   rms_norm_probe: OmniXPU rms_norm_kernel<bf16, GS=32, BS=64> emulation for H = 4096
//   linear_probe:   BF16 x[R,K] @ w[N,K]^T candidates against oneDNN
#include <cstdint>

#include <c10/xpu/XPUStream.h>
#include <sycl/ext/oneapi/bfloat16.hpp>
#include <sycl/ext/oneapi/matrix/matrix.hpp>
#include <sycl/sycl.hpp>
#include <torch/extension.h>

// strict FP semantics: every variant below is evaluated exactly as written
#pragma float_control(precise, on)
#pragma clang fp contract(off)
namespace cmdx {
namespace {
using bf16 = sycl::ext::oneapi::bfloat16;
namespace jm = sycl::ext::oneapi::experimental::matrix;
class RmsProbe;
class LinProbeScalar;
class LinProbeDpas;

// the EU's math.rsqt (what ESIMD rsqrt lowers to); SPMD sycl::native::rsqrt lowers differently
inline float hw_rsqrt(float x) {
#if defined(__SYCL_DEVICE_ONLY__)
    float r;
    __asm__ volatile("rsqrt (M1, 16) %0(0,0)<1> %1(0,0)<1;1,0>" : "=rw"(r) : "rw"(x));
    return r;
#else
    return x;
#endif
}

inline float sq_acc(float a, float x, int fma_mode) {
#pragma clang fp contract(off)
    if (fma_mode) return sycl::fma(x, x, a);
    const float p = x * x;
    return a + p;
}
}  // namespace

torch::Tensor g_rms_stats;
torch::Tensor rms_stats() { return g_rms_stats; }
torch::Tensor rms_norm_probe(torch::Tensor x, torch::Tensor w, double eps, int64_t variant) {
    TORCH_CHECK(x.scalar_type() == at::kBFloat16 && x.is_contiguous() && x.size(-1) == 4096, "x bf16 [R,4096]");
    const int64_t R = x.numel() / 4096;
    auto out = torch::empty_like(x);
    g_rms_stats = torch::empty({R, 2}, x.options().dtype(at::kFloat));
    float* stp = g_rms_stats.data_ptr<float>();
    const auto* xp = reinterpret_cast<const bf16*>(x.data_ptr());
    const auto* wp = reinterpret_cast<const bf16*>(w.data_ptr());
    auto* op = reinterpret_cast<bf16*>(out.data_ptr());
    const float e = static_cast<float>(eps);
    const int fma_mode = variant & 1, rs_mode = (variant >> 1) & 3, pmode = (variant >> 3) & 3;
    c10::xpu::getCurrentXPUStream().queue().submit([&](sycl::handler& cgh) {
        sycl::local_accessor<float, 2> v(sycl::range<2>(32, 64), cgh);
        sycl::local_accessor<float, 1> accs(32, cgh);
        cgh.parallel_for<RmsProbe>(sycl::nd_range<1>(R * 64, 64), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
#pragma clang fp contract(off)
            const int64_t r = it.get_group(0);
            const int j = it.get_local_id(0);
            const bf16* xr = xp + r * 4096;
            // emulated ESIMD thread et owns blocks 2et, 2et+1 (sub_nb = 2); accv[j] accumulates in order
            for (int et = 0; et < 32; ++et) {
                float a = 0.f;
                a = sq_acc(a, static_cast<float>(xr[(2 * et) * 64 + j]), fma_mode);
                a = sq_acc(a, static_cast<float>(xr[(2 * et + 1) * 64 + j]), fma_mode);
                v[et][j] = a;
            }
            sycl::group_barrier(it.get_group());
            // esimd detail::sum: halving tree v[0:N/2] + v[N/2:N]
            for (int n = 32; n >= 1; n /= 2) {
                if (j < n)
                    for (int et = 0; et < 32; ++et) v[et][j] = v[et][j] + v[et][j + n];
                sycl::group_barrier(it.get_group());
            }
            if (j < 32) accs[j] = v[j][0] / 4096;
            sycl::group_barrier(it.get_group());
            for (int n = 16; n >= 1; n /= 2) {
                if (j < n) accs[j] = accs[j] + accs[j + n];
                sycl::group_barrier(it.get_group());
            }
            const float mean = accs[0];
            float scale;
            if (rs_mode == 0) scale = sycl::native::rsqrt(mean + e);
            else if (rs_mode == 1) scale = sycl::rsqrt(mean + e);
            else if (rs_mode == 2) scale = 1.f / sycl::sqrt(mean + e);
            else scale = hw_rsqrt(mean + e);
            if (j == 0) { stp[r * 2] = mean; stp[r * 2 + 1] = scale; }
            for (int i = j; i < 4096; i += 64) {
                const float xv = static_cast<float>(xr[i]), wv = static_cast<float>(wp[i]);
                float y;
                if (pmode == 0) { const float t = xv * scale; y = t * wv; }
                else if (pmode == 1) { const float t = scale * wv; y = xv * t; }
                else if (pmode == 2) { const float t = xv * wv; y = t * scale; }
                else y = static_cast<float>(static_cast<double>(xv) * static_cast<double>(scale) * static_cast<double>(wv));
                op[r * 4096 + i] = static_cast<bf16>(y);
            }
        });
    });
    return out;
}

torch::Tensor linear_probe(torch::Tensor x, torch::Tensor w, int64_t variant) {
    TORCH_CHECK(x.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kBFloat16, "bf16");
    const int64_t K = x.size(-1), R = x.numel() / K, N = w.size(0);
    auto out = torch::empty({R, N}, x.options());
    const auto* xp = reinterpret_cast<const bf16*>(x.data_ptr());
    const auto* wp = reinterpret_cast<const bf16*>(w.data_ptr());
    auto* op = reinterpret_cast<bf16*>(out.data_ptr());
    auto& q = c10::xpu::getCurrentXPUStream().queue();
    if (variant < 10) {  // scalar orders: 0 sequential fma, 1 sequential mul+add, 2+S: S-way strided partials
        q.parallel_for<LinProbeScalar>(sycl::range<1>(R * N), [=](sycl::id<1> id) {
#pragma clang fp contract(off)
            const int64_t r = id[0] / N, n = id[0] % N;
            float acc = 0.f;
            if (variant == 0) for (int64_t k = 0; k < K; ++k) acc = sycl::fma(float(xp[r * K + k]), float(wp[n * K + k]), acc);
            else for (int64_t k = 0; k < K; ++k) { const float p = float(xp[r * K + k]) * float(wp[n * K + k]); acc = acc + p; }
            op[r * N + n] = static_cast<bf16>(acc);
        });
    } else {  // DPAS 8x16x16 with KS partial FP32 accumulators: variant = 1000 + 10 * KS + mode
              // mode 0/1: chunk c (K16) -> acc c % KS, combine sequential/tree; 2/3: contiguous K ranges;
              // 4/5: K32 chunks interleaved
        const int KS = int((variant - 1000) / 10), mode = int(variant % 10);
        q.submit([&](sycl::handler& cgh) {
            sycl::local_accessor<float, 2> part(sycl::range<2>(64, 128), cgh);
            cgh.parallel_for<LinProbeDpas>(sycl::nd_range<1>(((R + 7) / 8) * (N / 16) * 16, 16),
                [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
                    auto sg = it.get_sub_group();
                    const int64_t g = it.get_group(0), nt = N / 16;
                    const int64_t r0 = (g / nt) * 8, n0 = (g % nt) * 16;
                    const int lane = sg.get_local_id()[0];
                    const int64_t chunks = K / 16;
                    for (int ks = 0; ks < KS; ++ks) {
                        jm::joint_matrix<sycl::sub_group, bf16, jm::use::a, 8, 16, jm::layout::row_major> a;
                        jm::joint_matrix<sycl::sub_group, bf16, jm::use::b, 16, 16, jm::layout::col_major> b;
                        jm::joint_matrix<sycl::sub_group, float, jm::use::accumulator, 8, 16> c;
                        jm::joint_matrix_fill(sg, c, 0.f);
                        for (int64_t ch = 0; ch < chunks; ++ch) {
                            int owner;
                            if (mode <= 1) owner = int(ch % KS);
                            else if (mode <= 3) owner = int(ch / (chunks / KS));
                            else owner = int((ch / 2) % KS);
                            if (owner != ks) continue;
                            const int64_t k = ch * 16;
                            jm::joint_matrix_load(sg, a, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(xp + r0 * K + k), K);
                            jm::joint_matrix_load(sg, b, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(wp + n0 * K + k), K);
                            jm::joint_matrix_mad(sg, c, a, b, c);
                        }
                        int e = 0;
                        jm::joint_matrix_apply(sg, c, [&](float& v) { part[ks][e * 16 + lane] = v; ++e; });
                    }
                    float res[8];
                    for (int i = 0; i < 8; ++i) {
                        if ((mode & 1) == 0) {
                            float acc = part[0][i * 16 + lane];
                            for (int ks = 1; ks < KS; ++ks) acc = acc + part[ks][i * 16 + lane];
                            res[i] = acc;
                        } else {
                            float t[64];
                            for (int ks = 0; ks < KS; ++ks) t[ks] = part[ks][i * 16 + lane];
                            for (int n = KS / 2; n >= 1; n /= 2)
                                for (int j = 0; j < n; ++j) t[j] = t[j] + t[j + n];
                            res[i] = t[0];
                        }
                    }
                    for (int i = 0; i < 8; ++i)
                        if (r0 + i < R) op[(r0 + i) * N + n0 + lane] = static_cast<bf16>(res[i]);
                });
        });
    }
    return out;
}
}  // namespace cmdx
